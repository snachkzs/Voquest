{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "pages/**", "use": "@vercel/static-build", "config": { "distDir": "pages" } },
    { "src": "assets/**", "use": "@vercel/static-build", "config": { "distDir": "assets" } },
    { "src": "scripts/**", "use": "@vercel/static-build", "config": { "distDir": "scripts" } },
    { "src": "styles/**", "use": "@vercel/static-build", "config": { "distDir": "styles" } },
    { "src": "components/**", "use": "@vercel/static-build", "config": { "distDir": "components" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/scripts/(.*)", "dest": "/scripts/$1" },
    { "src": "/styles/(.*)", "dest": "/styles/$1" },
    { "src": "/components/(.*)", "dest": "/components/$1" },
    { "src": "/(.*)", "dest": "/pages/$1" }
  ]
}
